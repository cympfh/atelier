# Grok
# XAI_API_KEY=

# Stable Diffusion WebUI / Forge (A1111 API)
# Windows browser: http://127.0.0.1:7862
# From WSL, 127.0.0.1 is WSL itself — Forge must use --listen, then:
#   SD_WEBUI_URL=http://$(grep nameserver /etc/resolv.conf | awk '{print $2}'):7862
# or host.docker.internal if available.
SD_WEBUI_URL=http://127.0.0.1:7862

# Tag suggest (tagskeeper-compatible). Default: ~/git/tagskeeper/tags.toml
# ATELIER_TAGS_TOML=/home/cympfh/git/tagskeeper/tags.toml

# ATELIER_HOST=0.0.0.0
# ATELIER_PORT=8000
# ATELIER_DATA_DIR=data
# ATELIER_ECHO=0
